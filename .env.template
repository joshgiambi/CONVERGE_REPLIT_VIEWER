# Environment Configuration Template
# Copy this file to .env and customize for your local development

# === DATABASE CONFIGURATION ===
# For local PostgreSQL (recommended for development):
DATABASE_URL="postgresql://your_username@localhost:5432/converge_viewer"

# For Neon cloud database (original setup):
# DATABASE_URL="postgresql://[user[:password]@][netloc][:port][/dbname][?param1=value1&...]"

# Force local PostgreSQL mode (optional):
# USE_LOCAL_POSTGRES=true

# === SERVER CONFIGURATION ===
NODE_ENV=development
PORT=3000

# === OPTIONAL SETTINGS ===
DEBUG=true

# === INSTRUCTIONS ===
# 1. Copy this file: cp .env.template .env
# 2. Edit .env with your local settings
# 3. Never commit .env to Git (it's in .gitignore)
